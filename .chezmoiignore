{{ if ne .chezmoi.os "darwin" }}
# macOS-only or host-specific; skip on non-macOS hosts (e.g. Linux OmniStation).
# Need both the dir and dir/** so chezmoi ignores the directory *and* its
# contents (a bare dir name doesn't recurse in chezmoi's matcher):
#   - iTerm2 is macOS-only (its symlink template resolves macOS-only paths).
#   - the committed chezmoi config pins a macOS sourceDir and autoPush, and the
#     boltdb is chezmoi's own runtime state; neither should deploy on Linux.
.config/iterm2
.config/iterm2/**
.config/chezmoi
.config/chezmoi/**
{{ end }}
