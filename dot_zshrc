# Make sure that .profile has been loaded, even if there was no "login shell"
# in our lineage. Done FIRST so PATH is sane before compinit and the rc.d
# fragments below run external tools.
# Load the full profile if it has not run in THIS process, OR if PATH is
# actually broken. The second check defends against a parent (e.g. Cursor /
# VS Code) injecting a cached, stripped environment that still carries an
# inherited _PROFILE_LOADED -- a stale flag claiming the profile ran when PATH
# was never built. /usr/bin is the sentinel for a sane PATH.
if [ -z "$_PROFILE_LOADED" ] || [[ ":$PATH:" != *":/usr/bin:"* ]]; then
    source ~/.profile
else
    # Always want arrayutil
    source ~/.profile.d/arrayutil
fi

autoload -Uz compinit && compinit
bindkey -e

source ~/.zsh/rc.d/options
source ~/.zsh/rc.d/prompt
source ~/.zsh/rc.d/editor
source ~/.zsh/rc.d/dir
source ~/.zsh/rc.d/direnv
source ~/.zsh/rc.d/fzf
source ~/.zsh/rc.d/homebrew
source ~/.zsh/rc.d/completion
source ~/.zsh/rc.d/autosuggestions
source ~/.zsh/rc.d/netlify
source ~/.zsh/rc.d/history
source ~/.zsh/rc.d/highlighting

source ~/.aliases

if [[ -f "$HOME/.zsh/rc.d/local" ]]; then
    source "$HOME/.zsh/rc.d/local"
fi
